{% if gallery.images %}
  <div class="c-gallery{{ gallery.classes ? ' ' ~ gallery.classes }}">
    <div class="c-gallery__images">
      {% for image in gallery.images %}
        {% set isFirstImage = loop.index == 1 %}
        {% set imageClasses = gallery.images|length > 1 ? "c-gallery__images-item js-gallery-image" : "c-gallery__images-item" %}
        {% set imageClasses = isFirstImage ? imageClasses ~ " this-is-active" : imageClasses %}
        {% include "@atoms/images/image/responsive-image.twig" with {
          "image": {
            "srcset": Image(image).src|resize(900, 900) ~ ' 768w, ' ~ Image(image).src|resize(1200, 1200) ~ ' 1024w',
            "src": Image(image).src,
            "alt": Image(image).alt,
          },
          "picture": {
            "classes": imageClasses,
          }
        } %}
      {% endfor %}
    </div>
    {% if gallery.images|length > 1 %}
      <div class="c-gallery__dots">
        {% for image in gallery.images %}
          <span class="c-gallery__dots-item js-gallery-dot{{ loop.index == 1 ? ' this-is-active' }}" tabindex="0"></span>
        {% endfor %}
      </div>
      <div class="c-gallery__controls">
        {% include "@atoms/buttons/button.twig" with {
          "button": {
            "aria-label": "Previous",
            "icon": {
              "name": "arrow-left",
              "classes": "o-icon--lg"
            },
            "variant": "bare",
            "classes": "c-gallery__arrow c-gallery__arrow--previous js-gallery-prev",
            "attributes": "tabindex='0'"
          }
        } %}
        {% include "@atoms/buttons/button.twig" with {
          "button": {
            "aria-label": "Next",
            "icon": {
              "name": "arrow-right",
              "classes": "o-icon--lg"
            },
            "variant": "bare",
            "classes": "c-gallery__arrow c-gallery__arrow--next js-gallery-next",
            "attributes": "tabindex='0'"
          }
        } %}
      </div>
    {% endif %}
  </div>
{% endif %}
